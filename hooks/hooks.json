{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v recall >/dev/null 2>&1 && recall hook session-start || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v recall >/dev/null 2>&1 && recall hook session-end || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
